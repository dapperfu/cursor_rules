# Python API Request Validation

## Requirement

Python APIs SHALL validate all requests at API boundaries using appropriate validation libraries.

### Validation at Boundaries

- All API endpoints SHALL validate input at the boundary (before processing)
- Validation SHALL occur as early as possible (fail fast)
- Invalid requests SHALL be rejected with clear error messages
- Response data SHALL also be validated before sending

### Validation Libraries

- APIs SHALL use `pydantic` for request/response validation
- APIs SHALL use framework-specific validation (FastAPI, Flask, etc.)
- Custom validators SHALL be well-documented and tested

### Error Response Formats

- Validation errors SHALL return consistent error response format
- Error responses SHALL include field-level error details
- Error responses SHALL be user-friendly and actionable

## Rationale

Request validation provides:

- **Security**: Prevents injection attacks and malformed data
- **Data Integrity**: Ensures data meets expected format and constraints
- **User Experience**: Clear error messages help users correct invalid input
- **System Stability**: Prevents invalid data from causing errors downstream
- **Type Safety**: Runtime validation complements static type checking
- **API Quality**: Well-validated APIs are more professional and reliable

## Implementation

### Pydantic Request Models

```python
from pydantic import BaseModel, Field, validator
from fastapi import FastAPI, HTTPException

app = FastAPI()

class CreateUserRequest(BaseModel):
    """User creation request with validation."""
    username: str = Field(..., min_length=3, max_length=50)
    email: str = Field(..., description="User email address")
    age: int = Field(..., ge=0, le=150)
    password: str = Field(..., min_length=12)
    
    @validator('email')
    def validate_email(cls, v: str) -> str:
        """Validate email format."""
        if '@' not in v:
            raise ValueError("Invalid email format")
        return v.lower()

@app.post("/api/users")
def create_user(user_data: CreateUserRequest) -> dict:
    """Create user with validated input."""
    # Input is already validated by FastAPI/Pydantic
    user = create_user_in_db(user_data.dict())
    return {"id": user.id, "username": user.username}
```

### Response Validation

```python
from pydantic import BaseModel

class UserResponse(BaseModel):
    """User response model with validation."""
    id: int
    username: str
    email: str
    created_at: datetime

@app.get("/api/users/{user_id}", response_model=UserResponse)
def get_user(user_id: int) -> UserResponse:
    """Get user with validated response."""
    user = get_user_from_db(user_id)
    return UserResponse(
        id=user.id,
        username=user.username,
        email=user.email,
        created_at=user.created_at
    )
```

### Error Response Format

```python
from fastapi import FastAPI, Request, status
from fastapi.responses import JSONResponse
from fastapi.exceptions import RequestValidationError

app = FastAPI()

@app.exception_handler(RequestValidationError)
async def validation_exception_handler(
    request: Request,
    exc: RequestValidationError
) -> JSONResponse:
    """Handle validation errors with consistent format."""
    errors = []
    for error in exc.errors():
        errors.append({
            "field": ".".join(str(loc) for loc in error["loc"]),
            "message": error["msg"],
            "type": error["type"],
        })
    
    return JSONResponse(
        status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,
        content={
            "error": "Validation failed",
            "details": errors,
        },
    )
```

### Field-Level Validation

```python
from pydantic import BaseModel, Field, validator
from typing import List

class UpdateItemRequest(BaseModel):
    """Item update request with field-level validation."""
    name: str = Field(None, min_length=1, max_length=100)
    price: float = Field(None, gt=0)
    tags: List[str] = Field(default_factory=list, max_items=10)
    
    @validator('price')
    def validate_price(cls, v: float | None) -> float | None:
        """Validate price is reasonable."""
        if v is not None and v > 1000000:
            raise ValueError("Price too high")
        return v
    
    @validator('tags')
    def validate_tags(cls, v: List[str]) -> List[str]:
        """Validate tags."""
        if len(v) > 10:
            raise ValueError("Maximum 10 tags allowed")
        return [tag.lower() for tag in v]
```

### Custom Validators

```python
from pydantic import BaseModel, validator
from datetime import datetime

class EventRequest(BaseModel):
    """Event creation request with custom validation."""
    name: str
    start_date: datetime
    end_date: datetime
    
    @validator('end_date')
    def validate_end_after_start(cls, v: datetime, values: dict) -> datetime:
        """Validate end date is after start date."""
        if 'start_date' in values and v <= values['start_date']:
            raise ValueError("End date must be after start date")
        return v
```

### Framework Integration

```python
# FastAPI automatically validates using Pydantic
from fastapi import FastAPI, Query, Path

app = FastAPI()

@app.get("/api/items")
def get_items(
    skip: int = Query(0, ge=0),
    limit: int = Query(10, ge=1, le=100),
    category: str = Query(..., min_length=1)
) -> list[dict]:
    """Get items with query parameter validation."""
    # FastAPI validates query parameters
    return get_items_from_db(skip=skip, limit=limit, category=category)

@app.get("/api/items/{item_id}")
def get_item(item_id: int = Path(..., gt=0)) -> dict:
    """Get item with path parameter validation."""
    # FastAPI validates path parameters
    return get_item_from_db(item_id)
```

